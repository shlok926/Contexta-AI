{
    "name": "ai-pdf-chatbot-langchain",
    "description": "AI PDF chatbot template based on the book Learning LangChain (O'Reilly)",
    "private": true,
    "version": "0.0.1",
    "author": "Mayo Oshin",
    "license": "MIT",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "yarn run turbo:command build",
        "turbo:command": "yarn turbo",
        "lint": "yarn run turbo:command lint",
        "lint:fix": "yarn run turbo:command lint:fix",
        "format": "yarn run turbo:command format",
        "format:check": "yarn run turbo:command format:check",
        "typecheck": "yarn run turbo:command typecheck",
        "test:unit": "yarn run turbo:command test",
        "test:integration": "yarn run turbo:command test:integration",
        "eval": "ts-node tests/eval/run_eval.ts",
        "eval:redteam": "ts-node tests/eval/run_red_team.ts"
    },
    "devDependencies": {
        "turbo": "latest"
    }
}
