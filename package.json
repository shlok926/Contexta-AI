{
    "name": "ai-pdf-chatbot-langchain",
    "description": "AI PDF chatbot template based on the book Learning LangChain (O'Reilly)",
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@1.22.22",
    "author": "Mayo Oshin",
    "license": "MIT",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "format": "turbo format",
        "format:check": "turbo format:check",
        "typecheck": "turbo typecheck",
        "test:unit": "turbo test",
        "test:integration": "turbo test:integration",
        "eval": "tsx tests/eval/run_eval.ts",
        "eval:redteam": "tsx tests/eval/run_red_team.ts"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "turbo": "latest"
    }
}
