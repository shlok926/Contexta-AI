{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env"],
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["**/dist/**"]
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "format": {
        "dependsOn": ["^format"]
      },
      "typecheck": {
        "dependsOn": ["^typecheck"]
      },
      "test": {
        "dependsOn": ["^test"]
      },
      "test:integration": {
        "dependsOn": ["^test:integration"]
      }
    }
  }