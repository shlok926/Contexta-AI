# =============================================================================
# Contexta-AI API Environment Configuration Template
# =============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Connectivity
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=placeholder-anon-key-min-10-chars-here

# JWT Verification Strategy: 'symmetric' (local/Docker) or 'asymmetric' (Supabase Cloud)
JWT_VERIFICATION_PROFILE=symmetric

# Symmetric JWT Verification (Required when JWT_VERIFICATION_PROFILE=symmetric; min 32 chars)
SUPABASE_JWT_SECRET=placeholder-jwt-secret-with-at-least-32-characters

# Asymmetric JWT Verification (Required when JWT_VERIFICATION_PROFILE=asymmetric)
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Optional Claim Validations
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Quarantined Privileged Service Role (Prohibited in normal request data plane; required only if ENABLE_PRIVILEGED_EXECUTION=true)
ENABLE_PRIVILEGED_EXECUTION=false
# SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-min-10-chars

# AI & LLM Providers
OPENAI_API_KEY=your-openai-api-key-here

# Optional: LangSmith for tracing
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=contexta-ai