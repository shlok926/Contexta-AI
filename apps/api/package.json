{
  "name": "@contexta/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/server.ts'], bundle: true, platform: 'node', format: 'esm', outfile: 'dist/server.js', packages: 'external' })\"",
    "start": "node dist/server.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
